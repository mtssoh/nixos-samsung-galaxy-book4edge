El dts del arbol de zensanp apunta el touchpad a 0x40 con hid-descr-addr
0x0e y sin reguladores. En el NP964XMA (16") el touchpad esta en 0x50 con
hid-descr-addr 0xd1 y necesita vdd/vddl explicitos: asi lo describe el DTB
que venia con el sistema y asi aparece en el bus (/sys/bus/i2c/devices/1-0050).
Sin esto el DTB generado deja la laptop sin touchpad.

--- a/arch/arm64/boot/dts/qcom/x1e80100-samsung-galaxy-book4-edge.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-samsung-galaxy-book4-edge.dts
@@ -901,13 +901,16 @@
 
 	status = "okay";
 
-	touchpad@40 {
+	touchpad@50 {
 		compatible = "hid-over-i2c";
-		reg = <0x40>;
+		reg = <0x50>;
 
-		hid-descr-addr = <0xe>;
+		hid-descr-addr = <0xd1>;
 		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
 
+		vdd-supply = <&vreg_misc_3p3>;
+		vddl-supply = <&vreg_l15b_1p8>;
+
 		pinctrl-0 = <&tpad_default>;
 		pinctrl-names = "default";
 	};
